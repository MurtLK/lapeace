# Copy to backend/.env (gitignored) and fill in YOUR machine's paths.
# Relative paths are resolved from the backend/ folder.

# Real data: both must be set. Leave both unset to serve the one-clip fixture.
SAMPLES_FILE=data/samples.saa.json
AUDIO_DIR=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/03_accented_english_SpeechAccentArchive/audio

# Only needed to regenerate data/samples.saa.json with `npm run import:saa`.
SAA_TRANSCRIPTS=/ABSOLUTE/PATH/TO/transcripts.csv
SAA_DATASET=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/03_accented_english_SpeechAccentArchive

# PORT=8787

# Live ElevenLabs agent (private). Server-side only, never put these in frontend code.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# webrtc (default, recommended for voice) or websocket
AGENT_CONNECTION=webrtc
# Origins allowed to create agent sessions (comma-separated). Add the UI dev server here.
CORS_ORIGIN=http://localhost:5173
# Base URL used in audio_url (default http://localhost:PORT)
# PUBLIC_BASE_URL=http://localhost:8787

# A/B comparison (Scribe vs local Whisper). Unset = /api/comparison returns 404.
COMPARISON_FILE=data/comparison.whisper.json
# Only for `npm run import:comparison`
# ALT_TRANSCRIPTS=/ABSOLUTE/PATH/TO/results/ab_whisper/whisper_transcripts.csv
# ALT_SETTINGS=/ABSOLUTE/PATH/TO/results/ab_whisper/whisper_settings.json
# Default clip for Section 1 (else worst Mandarin/Punjabi clip)
# FEATURED_CLIP_ID=mandarin45
# Behind the Cloudflare tunnel, rate-limit by visitor IP (only when tunnelled)
# TRUST_CF_CONNECTING_IP=1

# 311 test caller audio (macOS: `npm run make:311-audio` creates it here). Unset = page shows results without audio.
CLARIFY_AUDIO_DIR=data/local/311-audio
# Only for `npm run build:census`
# CENSUS_DIR=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/01_people_census
# CROSSWALK_FILE=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/language_crosswalk.csv

# Live Call Check (/call-check). Needs ELEVENLABS_API_KEY (speech-to-text). Optional prototype voice detector:
# VOICE_DETECTOR_PYTHON=/path/to/python-with-numpy
# VOICE_DETECTOR_SCRIPT=scripts/voice_detector.py
# VOICE_DETECTOR_MODEL=data/voice_model.json
# CALLCHECK_LANGUAGE=eng   # optional; leave unset to auto-detect the caller's language
