# Copy to backend/.env (gitignored) and fill in YOUR machine's paths.
# Relative paths are resolved from the backend/ folder.

# Real data: both must be set. Leave both unset to serve the one-clip fixture.
SAMPLES_FILE=data/samples.saa.json
AUDIO_DIR=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/03_accented_english_SpeechAccentArchive/audio

# Only needed to regenerate data/samples.saa.json with `npm run import:saa`.
SAA_TRANSCRIPTS=/ABSOLUTE/PATH/TO/transcripts.csv
SAA_DATASET=/ABSOLUTE/PATH/TO/Mississauga_Unheard_ElevenLabs_Track/03_accented_english_SpeechAccentArchive

# PORT=8787

# Live ElevenLabs agent (private). Server-side only, never put these in frontend code.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# webrtc (default, recommended for voice) or websocket
AGENT_CONNECTION=webrtc
# Lock CORS to the UI's origin when you deploy, e.g. http://localhost:5173
# CORS_ORIGIN=*
