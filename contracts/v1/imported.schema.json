{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lapeace.local/contracts/v1/imported.schema.json",
  "title": "Offline Buzz import and evaluated ward artifacts",
  "$defs": {
    "ImportedRun": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_type": {
          "const": "imported_run"
        },
        "run_id": {
          "type": "string",
          "pattern": "^buzz-[0-9a-f]{24}$"
        },
        "identity": {
          "type": "object",
          "properties": {
            "parent_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reference_csv_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profile": {
              "type": "object",
              "properties": {
                "application": {
                  "const": "Buzz"
                },
                "engine": {
                  "const": "Whisper"
                },
                "model_id": {
                  "type": "null"
                },
                "settings": {
                  "type": "null"
                },
                "uniform_settings_attested": {
                  "type": "boolean"
                },
                "attested_by": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "application",
                "engine",
                "model_id",
                "settings",
                "uniform_settings_attested",
                "attested_by"
              ],
              "additionalProperties": false
            },
            "predictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sample_id": {
                    "type": "string"
                  },
                  "audio_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "export_filename": {
                    "type": "string"
                  },
                  "snapshot": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "adjacent_audio_verified": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sample_id",
                  "audio_sha256",
                  "export_filename",
                  "snapshot",
                  "sha256",
                  "adjacent_audio_verified"
                ],
                "additionalProperties": false
              },
              "minItems": 40,
              "maxItems": 40
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "attested_by": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "enum": [
                "provider",
                "fixture"
              ]
            }
          },
          "required": [
            "parent_manifest_sha256",
            "reference_csv_sha256",
            "profile",
            "predictions",
            "reviewer",
            "attested_by",
            "origin"
          ],
          "additionalProperties": false
        },
        "manifest_path": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalization_version": {
          "const": "en_v1"
        },
        "created_at": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "provider",
            "fixture"
          ]
        },
        "provider": {
          "const": "buzz"
        },
        "model_id": {
          "type": "null"
        },
        "settings": {
          "type": "null"
        },
        "request_count": {
          "const": 0
        },
        "submitted_audio_seconds": {
          "const": 0
        },
        "status": {
          "const": "complete"
        },
        "code": {
          "$ref": "#/$defs/Code"
        }
      },
      "required": [
        "schema_version",
        "artifact_type",
        "run_id",
        "identity",
        "manifest_path",
        "manifest_sha256",
        "review_sha256",
        "settings_sha256",
        "normalization_version",
        "created_at",
        "origin",
        "provider",
        "model_id",
        "settings",
        "request_count",
        "submitted_audio_seconds",
        "status",
        "code"
      ],
      "additionalProperties": false
    },
    "EvaluatedWard": {
      "type": "object",
      "properties": {
        "ward": {
          "$ref": "#/$defs/Ward/properties/ward"
        },
        "population_language_base": {
          "$ref": "#/$defs/Ward/properties/population_language_base"
        },
        "ward10_corrected": {
          "$ref": "#/$defs/Ward/properties/ward10_corrected"
        },
        "knows_neither_english_nor_french": {
          "$ref": "#/$defs/Ward/properties/knows_neither_english_nor_french"
        },
        "covered_home_speakers": {
          "$ref": "#/$defs/Ward/properties/covered_home_speakers"
        },
        "top14_home_speakers": {
          "$ref": "#/$defs/Ward/properties/top14_home_speakers"
        },
        "coverage_of_top14": {
          "$ref": "#/$defs/Ward/properties/coverage_of_top14"
        },
        "index": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "index_status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contributions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "cohort_id": {
                "type": "string"
              },
              "home_speakers": {
                "type": "integer",
                "minimum": 0
              },
              "weight": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "gap": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "cohort_id",
              "home_speakers",
              "weight",
              "gap"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ward",
        "population_language_base",
        "ward10_corrected",
        "knows_neither_english_nor_french",
        "covered_home_speakers",
        "top14_home_speakers",
        "coverage_of_top14",
        "index",
        "index_status",
        "run_id",
        "contributions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "index_status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "index": {
                "type": "null"
              },
              "run_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "index": {
                "type": "number"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "EvaluatedWards": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_type": {
          "const": "wards"
        },
        "wards": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/EvaluatedWard"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "schema_version",
        "artifact_type",
        "wards",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
